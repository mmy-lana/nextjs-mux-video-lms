{
  "name": "nextjs-mux-video-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:playback": "node --experimental-strip-types --no-warnings scripts/verify-playback.ts",
    "verify:responsive": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@mux/mux-node": "latest",
    "@mux/mux-player-react": "latest",
    "@mux/mux-uploader-react": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "npm-check-updates": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
